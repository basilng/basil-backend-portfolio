{
  "name": "basil-backend-engineer-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run check && npm run lint && npm run format:check && npm run security:check",
    "build": "npm run validate && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "test:a11y": "playwright test",
    "audit": "npm audit --audit-level=high",
    "ci": "npm run audit && npm run build && npm run test:a11y",
    "security:check": "node scripts/verify-security.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.0.1",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
