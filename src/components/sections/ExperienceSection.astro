---
import { experiences } from "../../data/profile";
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container">
    <header class="section-header">
      <p class="eyebrow">Experience</p>
      <h2 id="experience-title" class="section-title">
        Engineering delivery and technical leadership
      </h2>
      <p class="section-description">
        More than eight years across payment, financial and enterprise backend systems.
      </p>
    </header>

    <div class="timeline">
      {
        experiences.map((experience) => (
          <article class="experience-card card">
            <header class="experience-header">
              <div>
                <h3>{experience.role}</h3>
                <p class="company">
                  {experience.company} · {experience.location}
                </p>
              </div>
              <p class="period">
                {experience.start} - {experience.end}
              </p>
            </header>

            <ul class="highlights">
              {experience.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>

            <ul class="tag-list" aria-label={`${experience.role} technologies`}>
              {experience.technologies.map((technology) => (
                <li class="tag">{technology}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .timeline {
    display: grid;
    gap: var(--space-6);
  }

  .experience-card {
    padding: var(--space-6);
  }

  .experience-header {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  h3 {
    margin-bottom: var(--space-2);
  }

  .company,
  .period {
    margin: 0;
  }

  .company {
    color: var(--colour-accent);
    font-weight: 700;
  }

  .period {
    color: var(--colour-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .highlights {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding-left: 1.25rem;
  }

  @media (min-width: 48rem) {
    .experience-header {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
  }
</style>
