---
import { siteConfig } from "../../data/site";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow">Staff Engineer · Java Backend Specialist</p>
      <h1 id="hero-title">Engineering backend systems that stay correct under pressure.</h1>
      <p class="hero-copy">
        I design and deliver secure, resilient and observable Java platforms for payment, financial
        and enterprise workloads - from API contracts and data models to cloud operation and
        production troubleshooting.
      </p>

      <div class="button-group">
        <a class="button button--primary" href="/projects/">View engineering projects</a>
        <a class="button button--secondary" href={siteConfig.links.resume} download
          >Download resume</a
        >
      </div>
    </div>

    <aside class="profile-card card" aria-label="Engineering focus">
      <p class="profile-title">Current engineering focus</p>
      <ul>
        <li>Java 21+ and Spring Boot</li>
        <li>REST and distributed API design</li>
        <li>Payment and transactional systems</li>
        <li>Kafka and event-driven architecture</li>
        <li>AWS, Kubernetes and observability</li>
        <li>Performance and reliability engineering</li>
      </ul>
    </aside>
  </div>
</section>

<style>
  .hero {
    display: grid;
    min-height: calc(100vh - var(--header-height));
    align-items: center;
    padding-block: var(--space-16);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-10);
    align-items: center;
  }

  h1 {
    max-width: 15ch;
    margin-bottom: var(--space-6);
  }

  .hero-copy {
    max-width: 62ch;
    margin-bottom: var(--space-8);
    font-size: var(--text-lg);
  }

  .profile-card {
    padding: var(--space-6);
  }

  .profile-title {
    margin-bottom: var(--space-5);
    color: var(--colour-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  li::before {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--colour-accent);
    content: "";
  }

  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(18rem, 0.65fr);
      gap: var(--space-16);
    }
  }
</style>
