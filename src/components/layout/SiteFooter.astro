---
import { siteConfig } from "../../data/site";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-main">
    <div>
      <strong>{siteConfig.name}</strong>
      <p>{siteConfig.shortDescription}</p>
    </div>

    <nav class="footer-links" aria-label="Footer links">
      <a href={siteConfig.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={siteConfig.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={siteConfig.links.email}>Email</a>
      <a href={siteConfig.links.resume} download>Resume</a>
    </nav>
  </div>

  <div class="container footer-meta">
    <span>© {currentYear} {siteConfig.name}</span>
    <span>Static Astro site. No tracking cookies.</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--colour-border);
    background: var(--colour-bg-alt);
  }

  .footer-main {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-12);
  }

  .footer-main p {
    max-width: 40rem;
    margin: var(--space-3) 0 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .footer-links a {
    color: var(--colour-text-secondary);
    font-weight: 680;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--colour-accent);
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: 1px solid var(--colour-border);
    color: var(--colour-text-muted);
    font-size: var(--text-xs);
  }

  @media (min-width: 48rem) {
    .footer-main {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .footer-meta {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
