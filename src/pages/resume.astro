---
import { education, experiences, skillGroups } from "../data/profile";
import { siteConfig } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Resume"
  description="Professional resume for Basil N G, Staff Engineer and Senior Java Backend Engineer."
>
  <section class="section">
    <div class="container container--narrow">
      <header class="resume-header">
        <p class="eyebrow">Resume</p>
        <h1>{siteConfig.name}</h1>
        <p class="role">{siteConfig.role}</p>
        <p>{siteConfig.description}</p>

        <div class="button-group">
          <a class="button button--primary" href={siteConfig.links.resume} download
            >Download PDF resume</a
          >
          <a
            class="button button--secondary"
            href={siteConfig.links.linkedin}
            target="_blank"
            rel="noopener noreferrer">LinkedIn</a
          >
          <a class="button button--secondary" href={siteConfig.links.email}>Email</a>
        </div>
      </header>

      <section aria-labelledby="resume-skills">
        <h2 id="resume-skills">Technical skills</h2>
        <div class="resume-grid">
          {
            skillGroups.map((group) => (
              <article class="resume-item">
                <h3>{group.title}</h3>
                <p>{group.skills.join(" · ")}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section aria-labelledby="resume-experience">
        <h2 id="resume-experience">Professional experience</h2>
        <div class="resume-list">
          {
            experiences.map((experience) => (
              <article class="resume-item">
                <header>
                  <h3>
                    {experience.role} · {experience.company}
                  </h3>
                  <p>
                    {experience.start} - {experience.end}
                  </p>
                </header>
                <ul>
                  {experience.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section aria-labelledby="resume-education">
        <h2 id="resume-education">Education</h2>
        <div class="resume-list">
          {
            education.map((item) => (
              <article class="resume-item">
                <h3>
                  {item.qualification} · {item.field}
                </h3>
                <p>
                  {item.institution}, {item.location}
                </p>
                <p>
                  {item.start} - {item.end}
                </p>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .resume-header {
    margin-bottom: var(--space-12);
  }

  h1 {
    margin-bottom: var(--space-2);
    font-size: var(--text-2xl);
  }

  .role {
    color: var(--colour-accent);
    font-weight: 750;
  }

  section section {
    margin-top: var(--space-12);
  }

  section section > h2 {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--colour-border);
    font-size: var(--text-xl);
  }

  .resume-grid,
  .resume-list {
    display: grid;
    gap: var(--space-6);
  }

  .resume-item h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
  }

  .resume-item p {
    margin-bottom: var(--space-2);
  }

  .resume-item ul {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.25rem;
  }

  @media (min-width: 48rem) {
    .resume-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
